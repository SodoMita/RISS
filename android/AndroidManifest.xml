<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.risslauncher.app"
    android:versionCode="1"
    android:versionName="0.1.0">

    <uses-sdk
        android:minSdkVersion="21"
        android:targetSdkVersion="33" />

    <!-- Required to see all installed apps on Android 11+ -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    
    <uses-permission android:name="android.permission.INTERNET" />
    
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:label="RISS Launcher"
        android:hasCode="false">
        
        <!--
            Theme.Wallpaper is what makes the home-screen wallpaper visible
            behind the launcher: it sets windowShowWallpaper (PhoneWindow turns
            that into FLAG_SHOW_WALLPAPER, telling the window manager to draw
            the wallpaper behind this window), a transparent window background
            and no background cache hint.

            Note that `android:showWallpaper` is NOT a valid <activity>
            attribute (it belongs to the WindowAnimation styleable), so the
            theme is the only way to ask for the wallpaper from the manifest.

            The window still needs an alpha pixel format: NativeActivity would
            otherwise keep it at RGB_565. See
            android_jni::make_window_translucent_jni.
        -->
        <activity
            android:name="android.app.NativeActivity"
            android:label="RISS Launcher"
            android:theme="@android:style/Theme.Wallpaper.NoTitleBar"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            
            <!-- CRITICAL: lib_name must match [lib] name in Cargo.toml exactly -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="riss_launcher" />
            
            <!-- Main launcher intent -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
